# Copiá este archivo a .env.local y completalo. .env.local no se commitea.
# Con `npx supabase start` los valores locales salen de `npx supabase status`.

# URL del proyecto de Supabase (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable (publishable / anon). Es segura para el navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL pública de la app (local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "true" cuando Google esté configurado en Supabase Auth; muestra el botón de Google.
NEXT_PUBLIC_GOOGLE_ENABLED=false

# La clave de servicio de Supabase (secret / service_role) NUNCA va en una variable NEXT_PUBLIC_
# ni en código que llegue al navegador. Hoy la app no la necesita.
